# Telegram bot
TELEGRAM_BOT_TOKEN=

# Required only for Local Telegram Bot API Server
# Obtain these credentials at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Optional Telegram Bot API client configuration
# Leave TELEGRAM_API_BASE_URL empty to use the cloud Bot API.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_TIMEOUT_SECONDS=1800

# Future services
REDIS_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
