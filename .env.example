# Telegram bot
TELEGRAM_BOT_TOKEN=

# Required only for Local Telegram Bot API Server
# Obtain these credentials at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Isolated Reel-only testing; production activation is not approved.
INSTAGRAM_TELEGRAM_ENABLED=false

# Public TikTok video delivery when explicitly enabled (also in production).
TIKTOK_TELEGRAM_ENABLED=false
# Per bot process, 1–8 operations; at most one per user.
TIKTOK_MAX_CONCURRENT_OPERATIONS=2

# Optional Telegram Bot API client configuration
# Leave TELEGRAM_API_BASE_URL empty to use the cloud Bot API.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_TIMEOUT_SECONDS=1800

# Future services
REDIS_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=

# Shared single-process work admission (no queue); waiting choices reserve user slots only.
DOWNLOAD_MAX_ACTIVE_REQUESTS=4
DOWNLOAD_LINK_INTERVAL_SECONDS=3
# Shared byte budgets; Local Bot API ceiling 2,000,000,000 bytes/file.
# Cloud Bot API additionally caps files at 50,000,000 bytes.
DOWNLOAD_MAX_FILE_BYTES=536870912
DOWNLOAD_MAX_REQUEST_BYTES=1073741824
DOWNLOAD_MAX_WORKSPACE_BYTES=3221225472
DOWNLOAD_MIN_FREE_BYTES=536870912

# User/pending capacity is separate from active work; repeated refusal notices are throttled.
DOWNLOAD_MAX_PENDING_REQUESTS=128
DOWNLOAD_NOTICE_INTERVAL_SECONDS=5
# YouTube retains the endpoint file range; independent acquisition/workspace protection.
YOUTUBE_MAX_FILE_BYTES=2000000000
YOUTUBE_MAX_REQUEST_BYTES=4294967296
YOUTUBE_MAX_WORKSPACE_BYTES=8589934592
